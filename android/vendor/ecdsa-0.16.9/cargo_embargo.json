{
  "run_cargo": false,
  "features": [
    "alloc",
    "arithmetic",
    "der",
    "digest",
    "hazmat",
    "pem",
    "pkcs8",
    "rfc6979",
    "signing",
    "spki",
    "std",
    "verifying"
  ],
  "module_name_overrides": {
    "external_rust_crates_ecdsa_license": "external_mls_rs_ecdsa_license",
    "libder": "libder_mls_rs",
    "libspki": "libspki_mls_rs"
  },
  "package": {
    "ecdsa": {
      "license_text": [
        "LICENSE-APACHE"
      ],
      "add_module_block": "../../module_block.bp"
    }
  }
}
