{
  "run_cargo": false,
  "features": [
    "default",
    "fast_serialize",
    "gsma_rcs_e2ee_feature",
    "last_resort_key_package_ext",
    "rfc_compliant",
    "self_remove_proposal",
    "std",
    "x509"
  ],
  "module_name_overrides": {
    "external_rust_crates_mls-rs-core_license": "external_mls_rs_license",
    "libmls_rs_codec": "libmls_rs_codec_mls_rs",
    "libmls_rs_core": "libmls_rs_core_mls_rs",
    "libzeroize": "libzeroize_mls_rs"
  },
  "package": {
    "mls-rs-core": {
      "patch": "../android/patches/use-shared-license.patch",
      "add_module_block": "../android/module_block.bp"
    }
  }
}
